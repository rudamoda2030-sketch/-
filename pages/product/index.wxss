.product-page {
  min-height: 100vh;
  padding-bottom: calc(210rpx + env(safe-area-inset-bottom));
  background: #fff;
  color: #171717;
}

.product-empty {
  margin: 48rpx 24rpx 0;
}

.product-toolbar {
  display: flex;
  height: 88rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #e8e6e2;
  background: #fff;
}

.toolbar-back,
.toolbar-share {
  display: flex;
  align-items: center;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #393632;
  font-size: 22rpx;
  line-height: 1.3;
}

.toolbar-back {
  gap: 8rpx;
}

.toolbar-back::after,
.toolbar-share::after {
  border: 0;
}

.toolbar-back:first-letter {
  font-size: 38rpx;
}

.toolbar-style {
  overflow: hidden;
  color: #8b8781;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.toolbar-share {
  min-width: 72rpx;
  justify-content: flex-end;
  color: #706a63;
}

.product-gallery-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background: #f5f3f0;
}

.product-gallery {
  width: 100%;
  height: 100%;
}

.gallery-media {
  display: block;
  width: 100%;
  height: 100%;
}

.gallery-count {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 8rpx 14rpx;
  border-radius: 24rpx;
  background: rgba(23, 23, 23, .62);
  color: #fff;
  font-size: 20rpx;
}

.media-thumbnails {
  width: 100%;
  padding: 16rpx 24rpx 4rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.thumbnail-row {
  display: inline-flex;
  gap: 12rpx;
}

.thumbnail {
  width: 104rpx;
  height: 130rpx;
  overflow: hidden;
  border: 2rpx solid #ebe8e3;
  border-radius: 4rpx;
  box-sizing: border-box;
  opacity: .62;
  transition: opacity .18s ease, border-color .18s ease;
}

.thumbnail-active {
  border-color: #9a7c5c;
  opacity: 1;
}

.thumbnail-image {
  display: block;
  width: 100%;
  height: 100%;
}

.product-content {
  padding: 0 28rpx;
}

.product-summary {
  padding: 22rpx 0 20rpx;
  border-bottom: 1rpx solid #e7e4df;
}

.product-name {
  display: block;
  margin-top: 0;
  color: #171717;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.3;
}

.product-meta {
  display: block;
  margin-top: 7rpx;
  color: #858078;
  font-size: 21rpx;
  line-height: 1.5;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 16rpx;
}

.product-price {
  color: #201e1b;
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: .5rpx;
}

.price-unit {
  color: #77716a;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.order-rules {
  display: flex;
  flex-wrap: wrap;
  gap: 0 10rpx;
  margin-top: 12rpx;
  color: #77716a;
  font-size: 20rpx;
}

.matrix-section {
  margin: 16rpx 0 0;
  padding: 20rpx 16rpx 16rpx;
  border: 1rpx solid #ebe8e3;
  border-radius: 4rpx;
  background: #fcfbfa;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.section-title {
  color: #292724;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: .5rpx;
}

.section-hint {
  color: #89837c;
  font-size: 17rpx;
}

.color-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 4rpx 0 14rpx;
}

.color-option {
  display: flex;
  min-width: 90rpx;
  min-height: 72rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  padding: 5rpx 10rpx;
  border: 1rpx solid #e5e2dd;
  border-radius: 4rpx;
  background: #fff;
  color: #514c45;
  font-size: 19rpx;
  box-sizing: border-box;
}

.color-option-selected {
  border-color: #171717;
  color: #171717;
  font-weight: 600;
}

.color-option .color-swatch {
  width: 32rpx;
  height: 32rpx;
}

.sku-color-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.sku-color-card {
  padding: 0 12rpx;
  border: 1rpx solid #ebe8e3;
  background: #fff;
}

.sku-color-heading {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  gap: 10rpx;
  color: #302d29;
  font-size: 21rpx;
  font-weight: 600;
}

.sku-color-total {
  margin-left: auto;
  color: #77716a;
  font-size: 18rpx;
  font-weight: 400;
}

.sku-color-chevron {
  width: 24rpx;
  color: #88837c;
  font-size: 30rpx;
  font-weight: 400;
  text-align: center;
}

.sku-cell-list {
  display: flex;
  flex-wrap: wrap;
  padding: 0 0 12rpx;
  border-top: 1rpx solid #f0eeeb;
}

.sku-quantity-cell {
  display: flex;
  width: 100%;
  min-height: 74rpx;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx;
  border-bottom: 1rpx solid #f0eeeb;
  box-sizing: border-box;
}

.sku-quantity-cell-selected {
  background: #f5f6f8;
}

.sku-size-info {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.sku-size-label {
  color: #403c37;
  font-size: 20rpx;
  font-weight: 600;
}

.sku-quantity-cell input {
  width: 144rpx;
  height: 56rpx;
  margin-left: 18rpx;
  padding: 0 10rpx;
  border: 1rpx solid #e3dfd9;
  border-radius: 3rpx;
  background: #fff;
  color: #171717;
  font-size: 22rpx;
  text-align: center;
  box-sizing: border-box;
}

.sku-unavailable-value {
  color: #d4d0ca;
  font-size: 22rpx;
  text-align: center;
}

.backorder-quantity {
  margin-left: 12rpx;
  color: #8a632a;
  font-size: 17rpx;
  white-space: nowrap;
}

.sku-empty {
  padding: 30rpx 16rpx;
  color: #87827b;
  font-size: 20rpx;
  text-align: center;
}

.color-swatch {
  width: 18rpx;
  height: 18rpx;
  flex-shrink: 0;
  border: 1rpx solid rgba(0, 0, 0, .14);
  border-radius: 50%;
}

.matrix-stock {
  color: #87827b;
  font-size: 15rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.matrix-unavailable {
  color: #a4a09a;
  font-size: 17rpx;
}

.matrix-placeholder {
  color: #c3beb7;
}

.purchase-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  min-height: 150rpx;
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
  padding: 12rpx 18rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e6e2dc;
  background: rgba(255, 255, 255, .98);
  box-shadow: 0 -8rpx 30rpx rgba(28, 25, 20, .06);
  box-sizing: content-box;
}

.purchase-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
  color: #77716a;
  font-size: 17rpx;
}

.purchase-summary-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.purchase-selection {
  overflow: hidden;
  color: #55514b;
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.purchase-count {
  color: #8a857f;
  font-size: 15rpx;
}

.purchase-amount {
  flex: 0 0 auto;
  color: #171717;
  font-size: 25rpx;
  font-weight: 700;
}

.purchase-actions {
  display: flex;
  width: 100%;
  align-items: stretch;
  gap: 8rpx;
}

.utility-action {
  position: relative;
  display: flex;
  width: 76rpx;
  min-width: 68rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: #fff;
  color: #45423e;
  font-size: 17rpx;
  line-height: 1.1;
}

.utility-action::after {
  border: 0;
}

.utility-icon {
  font-size: 29rpx;
  line-height: 1;
}

.cart-icon-wrap {
  position: relative;
  line-height: 1;
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -16rpx;
  min-width: 34rpx;
  height: 25rpx;
  padding: 0 5rpx;
  border-radius: 16rpx;
  background: #171717;
  color: #fff;
  font-size: 13rpx;
  line-height: 25rpx;
  text-align: center;
}

.purchase-button {
  flex: 1;
  height: 78rpx;
  margin: 0;
  min-width: 70rpx;
  padding: 0 8rpx;
  border-radius: 0;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 78rpx;
  white-space: nowrap;
}

.purchase-button {
  border: 1rpx solid #171717;
  background: #171717;
  color: #fff;
  letter-spacing: 1rpx;
}

.purchase-button:not([disabled]):active {
  border-color: #40372e;
  background: #40372e;
}

.purchase-button[disabled] {
  background: #d4d0ca;
  color: #fff;
}

.purchase-button::after {
  border: 0;
}

.product-details {
  margin: 24rpx 0 180rpx;
  border-top: 1rpx solid #e6e2dc;
}

.product-details-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  color: #292929;
  font-size: 22rpx;
  font-weight: 600;
}

.product-details-content {
  padding: 0 0 24rpx;
  color: #77716a;
  font-size: 20rpx;
  line-height: 1.6;
}
