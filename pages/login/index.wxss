}

.account-input {
  padding-right: 128rpx;
}

.inline-code-button {
  position: absolute;
  right: 12rpx;
  display: flex;
  box-sizing: border-box;
  width: 96rpx;
  min-width: 0;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 8rpx;
  border-left: 1rpx solid #e6e3de;
  border-radius: 0;
  background: #fff;
  color: #796a55;
  font-size: 20rpx;
  line-height: 44rpx;
}

.inline-code-button::after {
