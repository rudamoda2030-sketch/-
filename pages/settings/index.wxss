.settings-page {
  min-height: 100vh;
  padding: 32rpx 30rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f5f4f1;
  color: #252421;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.account-card {
  display: flex;
  min-height: 150rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  border-radius: 18rpx;
  background: #252421;
  color: #fff;
}

.account-copy,
.preference-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 9rpx;
}

.account-title {
  font-size: 30rpx;
  font-weight: 550;
  letter-spacing: 0.2rpx;
}

.account-description {
  color: #b8b4ad;
  font-size: 22rpx;
  line-height: 1.5;
}

.account-action {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  flex: 0 0 50rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  color: #d5c7b3;
  font-size: 36rpx;
  line-height: 1;
}

.settings-group {
  overflow: hidden;
  margin-top: 20rpx;
  border: 1rpx solid #ebe8e2;
  border-radius: 16rpx;
  background: #fff;
}

.preference-group {
  margin-top: 22rpx;
}

.preference-row,
.settings-row {
  display: flex;
  min-height: 100rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 26rpx;
  border-bottom: 1rpx solid #f0eee9;
  box-sizing: border-box;
}

.preference-row-last,
.settings-row-last {
  border-bottom: 0;
}

.row-title {
  color: #292824;
  font-size: 26rpx;
  font-weight: 450;
  letter-spacing: 0.2rpx;
}

.row-note {
  color: #918c84;
  font-size: 20rpx;
  line-height: 1.45;
}

.picker-value {
  display: flex;
  min-width: 118rpx;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
  color: #746b5e;
  font-size: 25rpx;
  text-align: right;
}

.picker-arrow {
  color: #aaa399;
  font-size: 28rpx;
  line-height: 1;
}

.row-arrow {
  color: #b1aaa0;
  font-size: 36rpx;
  line-height: 1;
}

.status-area {
  padding: 12rpx 8rpx 0;
}

.sync-status,
.preference-error {
  color: #8a857d;
  font-size: 20rpx;
  line-height: 1.6;
}

.preference-error {
  padding-top: 8rpx;
  color: #9a4037;
}

.legal-group {
  margin-top: 20rpx;
}

.logout-button {
  margin-top: 26rpx;
  border: 1rpx solid #e8e1dc;
  border-radius: 14rpx;
  background: #fff;
  color: #8e5149;
  font-size: 25rpx;
  font-weight: 400;
}

.logout-button::after {
  border: 0;
}


.account-card {
  min-height: 164rpx;
  padding: 0 34rpx;
  border-radius: 20rpx;
  background: linear-gradient(112deg, #282723 0%, #1d1c19 100%);
  box-shadow: 0 12rpx 30rpx rgba(35, 32, 27, 0.08);
}

.account-title {
  font-size: 31rpx;
  letter-spacing: 0.5rpx;
}

.settings-group {
  margin-top: 22rpx;
  border-color: #eeece7;
  border-radius: 18rpx;
  box-shadow: 0 5rpx 18rpx rgba(37, 36, 33, 0.025);
}

.preference-group {
  margin-top: 24rpx;
}

.preference-row,
.settings-row {
  min-height: 104rpx;
  padding-right: 28rpx;
  padding-left: 28rpx;
  border-bottom-color: #f2f0ec;
}

.row-title {
  font-size: 27rpx;
  letter-spacing: 0.1rpx;
}

.row-note {
  color: #969087;
  font-size: 20rpx;
}

.picker-value {
  min-width: 132rpx;
  justify-content: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 9rpx;
  background: #f7f5f1;
  color: #665b4d;
  font-size: 23rpx;
}

.picker-arrow {
  color: #a99b88;
  font-size: 24rpx;
}

.preference-row switch {
  transform: scale(0.92);
  transform-origin: right center;
}

.row-arrow {
  color: #b7afa4;
  font-size: 34rpx;
}

.status-area {
  margin: 0 8rpx;
  padding: 14rpx 12rpx 0;
  border-left: 2rpx solid #c4ae8b;
}

.sync-status,
.preference-error {
  padding-left: 12rpx;
  color: #878178;
  font-size: 19rpx;
}

.preference-error {
  color: #9a4037;
}

.legal-group {
  margin-top: 18rpx;
}

.logout-button {
  min-height: 86rpx;
  margin-top: 28rpx;
  border-color: #eee8e2;
  border-radius: 14rpx;
  color: #8b5a50;
  letter-spacing: 1rpx;
}

.creator-hub {
  overflow: hidden;
  padding: 28rpx;
  border: 1rpx solid #ebe8e2;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 5rpx 18rpx rgba(37, 36, 33, 0.025);
}

.creator-hub-state,
.creator-hub-empty {
  padding: 36rpx 12rpx;
  color: #918c84;
  font-size: 23rpx;
  text-align: center;
}

.creator-hub-retry {
  display: block;
  padding-top: 18rpx;
  color: #786448;
}

.creator-hub-profile {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  gap: 18rpx;
}

.creator-hub-avatar {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 50%;
  background: #f2efe9;
}

.creator-hub-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6f604e;
  font-size: 34rpx;
}

.creator-hub-identity {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.creator-hub-name {
  overflow: hidden;
  color: #292824;
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.creator-hub-bio {
  overflow: hidden;
  color: #918c84;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.creator-hub-edit {
  padding: 12rpx 2rpx 12rpx 12rpx;
  color: #786448;
  font-size: 22rpx;
}

.creator-hub-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 28rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f1efeb;
  border-bottom: 1rpx solid #f1efeb;
}

.creator-hub-stats view {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  align-items: center;
}

.creator-hub-stats text:first-child {
  color: #292824;
  font-size: 27rpx;
  font-weight: 600;
}

.creator-hub-stats text:last-child {
  color: #918c84;
  font-size: 19rpx;
}

.creator-hub-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.creator-hub-action {
  display: flex;
  min-height: 68rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e9e5de;
  border-radius: 12rpx;
  color: #554a3b;
  font-size: 23rpx;
}

.creator-hub-action-primary {
  border-color: #252421;
  background: #252421;
  color: #fff;
}

.creator-hub-posts-heading {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
  color: #292824;
  font-size: 24rpx;
  font-weight: 550;
}

.creator-hub-posts-heading text:last-child {
  color: #918c84;
  font-size: 21rpx;
  font-weight: 400;
}

.creator-hub-post-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 18rpx;
}

.creator-hub-post {
  position: relative;
  overflow: hidden;
  height: 220rpx;
  border-radius: 8rpx;
  background: #f2efe9;
}

.creator-hub-post-image,
.creator-hub-post-placeholder {
  width: 100%;
  height: 100%;
}

.creator-hub-video-mark {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  color: #fff;
  font-size: 20rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.5);
}

.creator-hub-post-status {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  padding: 8rpx 6rpx;
  background: rgba(25, 24, 22, 0.58);
  color: #fff;
  font-size: 17rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-editor-mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(22, 21, 19, 0.48);
}

.profile-editor-sheet {
  width: 100%;
  padding: 30rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #f8f7f4;
  box-sizing: border-box;
}

.profile-editor-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  color: #292824;
  font-size: 29rpx;
  font-weight: 600;
}

.profile-editor-close {
  padding: 0 8rpx;
  color: #918c84;
  font-size: 38rpx;
  font-weight: 400;
}

.profile-editor-label {
  display: block;
  margin: 18rpx 0 10rpx;
  color: #706b63;
  font-size: 21rpx;
}

.profile-editor-input,
.profile-editor-textarea {
  width: 100%;
  padding: 18rpx;
  border: 1rpx solid #e8e4dd;
  border-radius: 12rpx;
  background: #fff;
  color: #292824;
  font-size: 24rpx;
  box-sizing: border-box;
}

.profile-editor-input {
  height: 82rpx;
}

.profile-editor-textarea {
  height: 180rpx;
}

.profile-editor-save {
  min-height: 84rpx;
  margin-top: 26rpx;
  border-radius: 12rpx;
  background: #252421;
  color: #fff;
  font-size: 25rpx;
}

.profile-editor-save::after {
  border: 0;
}
