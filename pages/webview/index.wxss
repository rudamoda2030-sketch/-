page {
  height: 100%;
  background: #fff;
}

.webview-error {
  display: flex;
  min-height: 100%;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 48rpx;
  color: #555;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.webview-error button {
  margin: 0;
  padding: 16rpx 32rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  background: #fff;
  color: #222;
  font-size: 24rpx;
}
