.order-success {
  margin: 20rpx 0;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #e9f1e8;
  color: #365336;
  font-size: 22rpx;
  line-height: 1.5;
}

.order-filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #ebe7e1;
  border-radius: 8rpx;
  background: #fff;
}

.order-filter-label {
  color: #1d1b19;
  font-size: 22rpx;
}

.order-filter-clear {
  color: #89847e;
  font-size: 22rpx;
}

.order-card {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #fff;
}

.order-header,
.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-number,
.order-date {
  display: block;
}

.order-number {
  font-size: 24rpx;
  font-weight: 600;
}

.order-date,
.order-status {
  margin-top: 8rpx;
  color: #817b73;
  font-size: 20rpx;
}

.order-items {
  display: block;
  margin: 18rpx 0;
  color: #514b45;
  font-size: 22rpx;
  line-height: 1.5;
}

.agreement-panel {
  margin: 16rpx 0;
  padding: 18rpx;
  border: 1rpx solid #e7e4df;
  border-radius: 10rpx;
  background: #faf9f7;
}

.agreement-heading,
.agreement-actions,
.agreement-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.agreement-title {
  color: #282521;
  font-size: 22rpx;
  font-weight: 600;
}

.agreement-status,
.agreement-summary,
.agreement-line {
  display: block;
  margin-top: 8rpx;
  color: #716b63;
  font-size: 19rpx;
  line-height: 1.5;
}

.agreement-detail {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #e7e4df;
}

.agreement-primary,
.agreement-secondary {
  flex: 1;
  margin: 12rpx 0 0;
  padding: 0 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.agreement-primary {
  color: #fff;
  background: #171717;
}

.agreement-secondary {
  color: #282521;
  background: #eeece8;
}

.payment-reference-form {
  margin-top: 12rpx;
  padding: 14rpx;
  border: 1rpx solid #e7e4df;
  border-radius: 8rpx;
  background: #fff;
}

.agreement-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 68rpx;
  margin-top: 10rpx;
  padding: 14rpx;
  border: 1rpx solid #e7e4df;
  border-radius: 8rpx;
  background: #faf9f7;
  color: #282521;
  font-size: 21rpx;
}

.agreement-modal-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.agreement-modal {
  width: 100%;
  max-height: 88vh;
  padding: 26rpx;
  overflow-y: auto;
  border-radius: 20rpx 20rpx 0 0;
  background: #fff;
}

.agreement-form {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.form-row {
  display: flex;
  gap: 14rpx;
}

.form-label {
  display: block;
  flex: 1;
  color: #716b63;
  font-size: 19rpx;
}

.form-label input,
.form-label textarea,
.picker-value {
  display: block;
  box-sizing: border-box;
  width: 100%;
  min-height: 68rpx;
  margin-top: 6rpx;
  padding: 14rpx;
  border: 1rpx solid #e7e4df;
  border-radius: 8rpx;
  background: #faf9f7;
  color: #282521;
  font-size: 21rpx;
}

.agreement-item-edit {
  padding-top: 10rpx;
  border-top: 1rpx solid #eeeae5;
}

.order-footer {
  padding-top: 16rpx;
  border-top: 1rpx solid #f0ede9;
  font-size: 22rpx;
}

.cancel-button {
  width: auto;
  margin: 0;
}

.progress-panel {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #eeeae5;
  border-radius: 10rpx;
  background: #faf9f7;
}

.progress-steps {
  display: flex;
  gap: 8rpx;
}

.progress-step {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.progress-bar {
  height: 6rpx;
  margin-bottom: 8rpx;
  border-radius: 6rpx;
  background: #e5e2dd;
}

.progress-bar-active {
  background: #171717;
}

.progress-label {
  color: #a09a91;
  font-size: 18rpx;
}

.progress-label-active {
  color: #171717;
  font-weight: 600;
}

.current-task {
  display: block;
  margin-top: 18rpx;
  color: #282521;
  font-size: 21rpx;
  font-weight: 600;
}

.tracking-toggle {
  width: auto;
  margin: 14rpx 0 0;
}

.tracking-panel {
  margin-top: 12rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  background: #f7f6f4;
}

.tracking-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.tracking-source,
.tracking-event-time,
.shipment-meta {
  color: #817b73;
  font-size: 18rpx;
}

.tracking-empty,
.tracking-error {
  display: block;
  padding: 14rpx 0;
  font-size: 20rpx;
  line-height: 1.5;
}

.tracking-error {
  color: #a12828;
}

.shipment-card {
  margin-top: 12rpx;
  padding: 16rpx;
  border: 1rpx solid #e8e5e0;
  border-radius: 8rpx;
  background: #fff;
}

.shipment-number,
.shipment-meta {
  display: block;
  margin-bottom: 7rpx;
}

.shipment-number,
.tracking-event-status {
  color: #282521;
  font-size: 21rpx;
  font-weight: 600;
}

.tracking-event {
  margin-top: 14rpx;
  padding-left: 14rpx;
  border-left: 2rpx solid #d8d4cd;
}

.tracking-event-status,
.tracking-event-time {
  display: block;
  margin-bottom: 5rpx;
}
