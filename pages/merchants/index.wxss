.intro {
  display: block;
  margin-top: 8rpx;
  color: #666;
}

.merchant-screen {
  padding: 32rpx 24rpx 160rpx;
  background: #f5f5f5;
  color: #111;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.merchant-screen .page-title {
  margin-top: 0;
  color: #111;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 36rpx;
  font-weight: 600;
}

.merchant-screen > .page-title,
.merchant-screen > .intro {
  visibility: hidden;
}

.merchant-search {
  box-sizing: border-box;
  height: 80rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  background: #fff;
  color: #222;
  font-size: 24rpx;
}

.find-store-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  background: #fff;
  color: #222;
  font-size: 24rpx;
}

.find-store-entry-active {
  background: #fafafa;
}

.find-store-entry-arrow {
  color: #999;
  font-size: 28rpx;
}

.merchant-list {
  margin-top: 20rpx;
}

.merchant-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  background: #fff;
}

.merchant-main {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.merchant-photo {
  display: block;
  width: 200rpx;
  height: 240rpx;
  flex: 0 0 200rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: #f0f0f0;
}

.merchant-photo-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  box-sizing: border-box;
  color: #777;
  font-size: 24rpx;
  text-align: center;
}

.merchant-info {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.merchant-name {
  color: #111;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
}

.merchant-category {
  color: #666;
  font-size: 22rpx;
  line-height: 1.5;
}

.merchant-description {
  display: -webkit-box;
  overflow: hidden;
  color: #555;
  font-size: 22rpx;
  line-height: 32rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.merchant-contact-row,
.merchant-website-row {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: 8rpx;
  color: #222;
  font-size: 22rpx;
  line-height: 34rpx;
}

.contact-label {
  flex: 0 0 auto;
  color: #666;
}

.merchant-contact {
  min-width: 0;
  flex: 1;
  color: #222;
  font-size: 22rpx;
  line-height: 34rpx;
  word-break: break-all;
}

.merchant-website {
  min-width: 0;
  flex: 1;
  color: #222;
  font-size: 22rpx;
  line-height: 34rpx;
  word-break: break-all;
}

.website-link {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: flex-start;
  gap: 8rpx;
}

.website-external {
  flex: 0 0 auto;
  color: #222;
  font-size: 22rpx;
  line-height: 34rpx;
}

.unavailable {
  color: #999;
}

.merchant-actions {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eaeaea;
}

.authorization-note {
  display: block;
  margin-bottom: 16rpx;
  color: #777;
  font-size: 20rpx;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.authorization-approved {
  color: #222;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.action-row {
  display: flex;
  gap: 12rpx;
}

.action-button {
  display: flex;
  box-sizing: border-box;
  height: 64rpx;
  min-height: 64rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  margin: 0;
  padding: 0 4rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  background: #fff;
  color: #222;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 1;
  white-space: nowrap;
}

.action-button[disabled] {
  background: #fff;
  color: #aaa;
}

.action-icon {
  font-size: 24rpx;
  line-height: 1;
}
