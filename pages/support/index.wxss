.support-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #f7f7f6;
  color: #171717;
  box-sizing: border-box;
}

.support-heading {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.support-eyebrow {
  color: #85817b;
  font-size: 17rpx;
  letter-spacing: 3rpx;
}

.support-title {
  font-size: 36rpx;
  font-weight: 700;
}

.support-description {
  color: #706d68;
  font-size: 21rpx;
  line-height: 1.6;
}

.support-form {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e8e6e2;
  background: #fff;
}

.support-field {
  display: flex;
  flex-direction: column;
  gap: 9rpx;
  color: #393632;
  font-size: 21rpx;
  font-weight: 600;
}

.support-field input,
.support-field textarea {
  width: 100%;
  min-height: 76rpx;
  padding: 18rpx;
  border: 1rpx solid #e7e4df;
  border-radius: 4rpx;
  background: #fff;
  color: #171717;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 1.5;
  box-sizing: border-box;
}

.support-field textarea {
  min-height: 220rpx;
}

.support-error {
  color: #a33131;
  font-size: 20rpx;
  line-height: 1.5;
}

.support-submit {
  height: 82rpx;
  margin: 4rpx 0 0;
  border-radius: 4rpx;
  background: #171717;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 82rpx;
}

.support-submit::after {
  border: 0;
}
