.analytics-title { overflow: hidden; color: #22211e; font-size: 23rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.analytics-status { color: #858178; font-size: 19rpx; }
.analytics-metrics { display: flex; flex-wrap: wrap; gap: 6rpx 18rpx; margin-top: 4rpx; color: #6f6a60; font-size: 19rpx; }
.analytics-delete { flex: none; padding: 6rpx 0 6rpx 10rpx; color: #b3261e; font-size: 20rpx; }
