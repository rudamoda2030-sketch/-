.store-banner {
  width: 100%;
  height: 300rpx;
  margin-top: 30rpx;
  border-radius: 12rpx;
  background: #eee8df;
}

.store-header {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.store-logo {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #eee8df;
}

.store-name-block {
  display: flex;
  flex-direction: column;
  margin-left: 22rpx;
}

.store-name {
  margin-bottom: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.store-tagline {
  display: block;
  margin-top: 26rpx;
  color: #514b45;
  font-size: 25rpx;
  line-height: 1.6;
}

.store-description {
  display: block;
  margin-top: 14rpx;
  color: #89847e;
  font-size: 23rpx;
  line-height: 1.7;
}

.route-value {
  margin-top: 24rpx;
  color: #9a7c5c;
  font-size: 22rpx;
}

.route-empty {
  margin-top: 48rpx;
}

.product-card {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #ebe7e1;
  border-radius: 12rpx;
  background: #fff;
}

.product-image {
  width: 180rpx;
  height: 210rpx;
  border-radius: 8rpx;
  background: #eee8df;
}

.product-info {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  padding: 0 20rpx;
}

.product-brand,
.product-style {
  color: #89847e;
  font-size: 20rpx;
}

.product-name {
  overflow: hidden;
  margin: 8rpx 0;
  font-size: 25rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.product-arrow {
  color: #a49c93;
  font-size: 36rpx;
}
