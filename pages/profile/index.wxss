.profile-page {
  min-height: 100vh;
  padding: 36rpx 32rpx calc(190rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f7f6f3;
}

.identity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 4rpx 40rpx;
}

.identity-main {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 22rpx;
}

.identity-avatar {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #e8e4de;
}

.identity-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1d1b19;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 42rpx;
}

.identity-copy {
  min-width: 0;
  flex: 1;
}

.identity-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.identity-name {
  overflow: hidden;
  max-width: 340rpx;
  color: #1d1b19;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-chip {
  flex: 0 0 auto;
  padding: 4rpx 12rpx;
  border: 1rpx solid #d9d4ce;
  border-radius: 4rpx;
  background: #fff;
  color: #6b6660;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.identity-chip-approved {
  border-color: #1d1b19;
  color: #1d1b19;
}

.identity-meta {
  display: block;
  margin-top: 10rpx;
  color: #89847e;
  font-size: 24rpx;
  line-height: 1.5;
}

.identity-action {
  flex: 0 0 auto;
  padding: 14rpx 22rpx;
  border: 1rpx solid #1d1b19;
  border-radius: 8rpx;
  color: #1d1b19;
  font-size: 24rpx;
}

.panel {
  margin-bottom: 24rpx;
  padding: 28rpx 26rpx 10rpx;
  border: 1rpx solid #ebe7e1;
  border-radius: 24rpx;
  background: #fff;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-title {
  color: #1d1b19;
  font-size: 28rpx;
  font-weight: 600;
}

.panel-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 2rpx;
  color: #89847e;
  font-size: 22rpx;
}

.panel-note {
  padding: 30rpx 0;
  color: #89847e;
  font-size: 24rpx;
  line-height: 1.6;
}

.panel-note-error {
  color: #1d1b19;
}

.order-grid {
  display: flex;
  margin-top: 8rpx;
}

.order-cell {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 4rpx 26rpx;
  border-right: 1rpx solid #f0ede8;
}

.order-cell:last-child {
  border-right: 0;
}

.order-count {
  color: #1d1b19;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 40rpx;
  line-height: 1;
}

.order-label {
  color: #89847e;
  font-size: 22rpx;
}

.rows {
  margin-bottom: 24rpx;
  border: 1rpx solid #ebe7e1;
  border-radius: 24rpx;
  background: #fff;
}

.row {
  display: flex;
  min-height: 108rpx;
  align-items: center;
  gap: 20rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid #f0ede8;
}

.row-last {
  border-bottom: 0;
}

.row-label {
  flex: 1;
  min-width: 0;
  color: #1d1b19;
  font-size: 28rpx;
}

.row-state {
  color: #89847e;
  font-size: 20rpx;
}

.row-badge {
  min-width: 32rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  background: #1d1b19;
  color: #fff;
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}

.row-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 auto;
}

.icon-key::before {
  position: absolute;
  top: 5rpx;
  left: 0;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #1d1b19;
  border-radius: 50%;
  box-sizing: border-box;
  content: '';
}

.icon-key::after {
  position: absolute;
  top: 15rpx;
  left: 20rpx;
  width: 12rpx;
  height: 3rpx;
  background: #1d1b19;
  content: '';
}

.icon-key-teeth {
  position: absolute;
  top: 15rpx;
  left: 26rpx;
  width: 3rpx;
  height: 9rpx;
  background: #1d1b19;
}

.icon-shield::before {
  position: absolute;
  top: 2rpx;
  left: 5rpx;
  width: 22rpx;
  height: 26rpx;
  border: 3rpx solid #1d1b19;
  border-radius: 6rpx 6rpx 14rpx 14rpx;
  box-sizing: border-box;
  content: '';
}

.icon-bell::before {
  position: absolute;
  top: 3rpx;
  left: 5rpx;
  width: 22rpx;
  height: 20rpx;
  border: 3rpx solid #1d1b19;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  box-sizing: border-box;
  content: '';
}

.icon-bell-clapper {
  position: absolute;
  top: 25rpx;
  left: 14rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #1d1b19;
}

.chevron {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 auto;
  border-top: 2rpx solid #b3ada5;
  border-right: 2rpx solid #b3ada5;
  transform: rotate(45deg);
}

.profile-footer {
  display: block;
  margin-top: 12rpx;
  color: #a9a49d;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

.modal-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(20, 18, 16, 0.42);
}

.modal-sheet {
  width: 100%;
  padding: 36rpx 32rpx 32rpx;
  border-radius: 28rpx;
  background: #fff;
  box-sizing: border-box;
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-title {
  color: #1d1b19;
  font-size: 30rpx;
  font-weight: 600;
}

.modal-close {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  margin: -8rpx -8rpx 0 0;
}

.modal-close-bar {
  position: absolute;
  top: 23rpx;
  left: 12rpx;
  width: 24rpx;
  height: 2rpx;
  background: #89847e;
}

.modal-close-bar-one {
  transform: rotate(45deg);
}

.modal-close-bar-two {
  transform: rotate(-45deg);
}

.modal-hint {
  display: block;
  margin-top: 22rpx;
  color: #89847e;
  font-size: 24rpx;
}

.modal-input {
  height: 96rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d9d4ce;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #1d1b19;
  font-size: 30rpx;
  letter-spacing: 6rpx;
}

.modal-input-placeholder {
  color: #b3ada5;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.modal-error {
  display: block;
  margin-top: 18rpx;
  color: #8a1f1f;
  font-size: 22rpx;
  line-height: 1.5;
}

.modal-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 92rpx;
  margin: 28rpx 0 0;
  border-radius: 12rpx;
  background: #1d1b19;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.modal-submit[disabled] {
  opacity: 0.6;
}

