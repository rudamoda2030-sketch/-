.tab-bar {
  position: fixed;
  z-index: 999;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 10rpx 12rpx calc(10rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5e5e5;
  background: rgba(255, 255, 255, 0.96);
}

.tab-item {
  position: relative;
  display: flex;
  width: auto;
  flex: 1;
  min-width: 0;
  min-height: 84rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  margin: 0;
  padding: 8rpx 2rpx 12rpx;
  border-radius: 12rpx;
  background: transparent;
  color: #a3a3a3;
  font-size: 22rpx;
  line-height: 1.2;
}

.tab-item::after {
  border: 0;
}

.tab-item-selected {
  color: #171717;
  font-weight: 600;
}

.tab-icon {
  height: 24rpx;
  color: #171717;
  font-size: 22rpx;
  line-height: 24rpx;
}

.tab-label {
  overflow: hidden;
  max-width: 100%;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-indicator {
  position: absolute;
  bottom: 2rpx;
  width: 48rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #171717;
}

.tab-bar-fashion {
  border-top-color: rgba(255, 255, 255, .12);
  background: rgba(8, 8, 8, .82);
}

.tab-bar-fashion .tab-item {
  color: rgba(255, 255, 255, .62);
}

.tab-bar-fashion .tab-item-selected {
  color: #fff;
}

.tab-bar-fashion .tab-icon {
  color: #fff;
}

.tab-bar-fashion .tab-indicator {
  background: #fff;
}

.tab-bar-fashion-immersive {
  display: block;
  padding: 6px 4px calc(6px + env(safe-area-inset-bottom));
  border-top-color: rgba(255, 255, 255, .08);
  background: rgba(0, 0, 0, .94);
  box-sizing: border-box;
}

.fashion-tab-row {
  display: flex;
  width: 100%;
  min-height: 54px;
  align-items: center;
  justify-content: space-around;
}

.fashion-tab-item {
  position: relative;
  display: flex;
  width: 20%;
  min-width: 0;
  height: 52px;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 2px;
  margin: 0;
  padding: 3px 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: rgba(255, 255, 255, .88);
  font-size: 10px;
  line-height: 1.2;
}

.fashion-tab-item::after {
  border: 0;
}

.fashion-icon {
  position: relative;
  display: block;
  width: 26px;
  height: 25px;
  color: #fff;
}

.fashion-icon-home:before {
  position: absolute;
  top: 4px;
  left: 6px;
  width: 14px;
  height: 14px;
  border-top: 2px solid #fff;
  border-left: 2px solid #fff;
  content: '';
  transform: rotate(45deg);
}

.fashion-icon-home:after {
  position: absolute;
  right: 5px;
  bottom: 1px;
  left: 5px;
  height: 12px;
  border: 2px solid #fff;
  border-top: 0;
  content: '';
}

.fashion-icon-home view {
  position: absolute;
  z-index: 1;
  bottom: 1px;
  left: 11px;
  width: 6px;
  height: 9px;
  background: #fff;
}

.fashion-friend-one,
.fashion-friend-two {
  position: absolute;
  bottom: 1px;
  width: 12px;
  height: 10px;
  border: 2px solid #fff;
  border-radius: 8px 8px 4px 4px;
  box-sizing: border-box;
}

.fashion-friend-one:before,
.fashion-friend-two:before {
  position: absolute;
  top: -12px;
  left: 2px;
  width: 7px;
  height: 7px;
  border: 2px solid #fff;
  border-radius: 50%;
  content: '';
}

.fashion-friend-one {
  left: 2px;
}

.fashion-friend-two {
  right: 2px;
}

.fashion-icon-inbox {
  height: 21px;
  margin-top: 2px;
  border: 2px solid #fff;
  border-radius: 5px;
  box-sizing: border-box;
}

.fashion-icon-inbox:after {
  position: absolute;
  right: 4px;
  bottom: -5px;
  left: 4px;
  height: 6px;
  border-bottom: 2px solid #fff;
  border-radius: 0 0 5px 5px;
  content: '';
}

.fashion-icon-inbox view {
  position: absolute;
  top: 6px;
  left: 4px;
  width: 14px;
  border-top: 2px solid #fff;
}

.fashion-profile-head {
  position: absolute;
  top: 1px;
  left: 9px;
  width: 9px;
  height: 9px;
  border: 2px solid #fff;
  border-radius: 50%;
}

.fashion-profile-body {
  position: absolute;
  bottom: 1px;
  left: 4px;
  width: 19px;
  height: 10px;
  border: 2px solid #fff;
  border-radius: 12px 12px 5px 5px;
  box-sizing: border-box;
}

.fashion-tab-badge {
  position: absolute;
  top: 1px;
  right: 17%;
  display: flex;
  min-width: 16px;
  height: 16px;
  align-items: center;
  justify-content: center;
  padding: 0 3px;
  border-radius: 12px;
  background: #ff3158;
  color: #fff;
  font-size: 9px;
  line-height: 1;
}

.fashion-tab-label {
  overflow: hidden;
  max-width: 100%;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fashion-tab-create {
  height: 40px;
}

.fashion-tab-plus {
  display: flex;
  width: 48px;
  height: 30px;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  background: #fff;
  box-shadow: -3px 0 #21d4e5, 3px 0 #ff3158;
  color: #151515;
  font-size: 29px;
  font-weight: 500;
  line-height: 1;
}
