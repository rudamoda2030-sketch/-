.site-header {
  position: relative;
  z-index: 10;
  display: flex;
  box-sizing: content-box;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #e8e6e2;
  background: #fff;
}

.site-menu-button {
  position: absolute;
  top: 50%;
  left: 16px;
  display: flex;
  width: 32px;
  height: 32px;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  padding: 3px;
  box-sizing: border-box;
  transform: translateY(calc(-50% + 10px));
}

.site-menu-line {
  display: block;
  width: 100%;
  height: 2px;
  background: #252421;
}

.site-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #171717;
  font-family: Georgia, "Times New Roman", serif;
  transform: translateY(6px);
}

.site-brand-name {
  font-size: 31px;
  letter-spacing: -2px;
  line-height: .82;
}

.site-brand-dot {
  color: #b49a6c;
}

.site-brand-caption {
  margin-top: 6px;
  font-family: Arial, sans-serif;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 4px;
}
