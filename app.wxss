page {
  min-height: 100%;
  background: #f7f6f3;
  color: #1d1b19;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.screen {
  min-height: 100vh;
  padding: 48rpx 40rpx 160rpx;
  box-sizing: border-box;
}

.eyebrow {
  color: #9a7c5c;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.page-title {
  display: block;
  margin-top: 14rpx;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 48rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.muted {
  color: #89847e;
  font-size: 26rpx;
  line-height: 1.7;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 92rpx;
  margin: 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.primary-button {
  background: #201e1b;
  color: #fff;
}

.secondary-button {
  border: 1rpx solid #d9d4ce;
  background: #fff;
  color: #201e1b;
}

button::after {
  border: 0;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 56rpx 0 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.surface {
  padding: 30rpx;
  border: 1rpx solid #ebe7e1;
  border-radius: 12rpx;
  background: #fff;
}

.empty-state {
  display: flex;
  min-height: 300rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  border: 1rpx dashed #d9d4ce;
  border-radius: 12rpx;
  text-align: center;
}

.empty-title {
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}
